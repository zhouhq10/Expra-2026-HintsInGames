# Kopiere diese Datei nach `.env` und trage deinen echten API-Key ein.
# `.env` ist gitignored — landet nie im Repo.

ANTHROPIC_API_KEY=sk-ant-PASTE-YOUR-KEY-HERE

# Optional: Modell-Override. Default ist claude-haiku-4-5 (am günstigsten).
# Wenn Instruction-Following im Pilot zu locker wirkt, hochstufen auf:
#   claude-sonnet-4-6  (~3x teurer)
#   claude-opus-4-7    (~5x teurer als sonnet)
# LLM_MODEL=claude-haiku-4-5
