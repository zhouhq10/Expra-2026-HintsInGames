# Kopiere diese Datei nach `.env` und trage deinen echten API-Key ein.
# `.env` ist gitignored — landet nie im Repo.

OPENAI_API_KEY=sk-PASTE-YOUR-KEY-HERE

# Optional: Modell-Override. Default ist gpt-4o-mini (günstig & schnell).
# Wenn das Instruction-Following im Pilot zu locker wirkt, hochstufen auf:
#   gpt-4o        (~10x teurer als 4o-mini, deutlich stärker)
#   gpt-5-mini    (modern, mittlere Kosten)
# LLM_MODEL=gpt-4o-mini

# --- Nur fürs öffentliche Deployment (z.B. Render) nötig ---------------------

# Zugangstoken: sobald gesetzt, müssen /api/hint und /api/results es im
# Header X-Access-Token mitschicken. Teilnehmer-URL bekommt dann ?key=<token>.
# Verhindert, dass Fremde den öffentlichen Proxy aufrufen (= OpenAI-Kosten).
# Leer lassen für lokale Entwicklung im vertrauten Netz.
# ACCESS_TOKEN=expra2026-geheim

# Webhook für Ergebnis-CSVs (z.B. Google-Apps-Script-Web-App-URL). Nötig in
# der Cloud, weil die lokale Platte dort bei Restart/Sleep geleert wird.
# RESULTS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
