# Kopiere diese Datei nach `.env` und trage deinen echten API-Key ein.
# `.env` ist gitignored — landet nie im Repo.

OPENAI_API_KEY=sk-PASTE-YOUR-KEY-HERE

# Optional: Modell-Override. Default ist gpt-4o-mini (günstig & schnell).
# Wenn das Instruction-Following im Pilot zu locker wirkt, hochstufen auf:
#   gpt-4o        (~10x teurer als 4o-mini, deutlich stärker)
#   gpt-5-mini    (modern, mittlere Kosten)
# LLM_MODEL=gpt-4o-mini
